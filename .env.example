# Copy to ~/.harness/.env (mode 0600) -- never commit a filled-in copy.
# Secrets belong here and nowhere else. Everything that is not a secret goes in
# config.toml, which is safe to check into a project repository.

# --- model providers ---------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# TOGETHER_API_KEY=
# GROQ_API_KEY=

# Local / self-hosted endpoints need no key, only a base URL in config.toml.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# VLLM_BASE_URL=http://localhost:8000/v1

# --- chat gateway ------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# DISCORD_BOT_TOKEN=
